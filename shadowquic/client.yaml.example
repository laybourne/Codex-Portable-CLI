inbound:
  type: socks
  bind-addr: 127.0.0.1:4080
outbound:
  type: shadowquic
  addr: example.com:443
  username: example-user
  password: REPLACE_WITH_NODE_PASSWORD
  server-name: example.com
  alpn:
  - h3
  initial-mtu: 1300
  congestion-control: bbr
  zero-rtt: true
  over-stream: false
log-level: info
